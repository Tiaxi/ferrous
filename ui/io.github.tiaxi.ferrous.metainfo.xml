<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>io.github.tiaxi.ferrous</id>
  <name>Ferrous</name>
  <summary>Play and inspect a local music library</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.tiaxi">
    <name>Tuomas Seppänen</name>
  </developer>

  <description>
    <p>
      Ferrous is a fast desktop music player built with Rust, Qt 6 and KDE
      Kirigami. It treats your folder structure as your library.
    </p>
    <ul>
      <li>Gapless playback through GStreamer, with repeat, shuffle and a session-restoring queue</li>
      <li>Folder-first library browsing that follows changes on disk, with ranked global search</li>
      <li>Live spectrogram and waveform views with centered and rolling modes</li>
      <li>Multi-file tag editing, renaming files from tags and album art lookup</li>
      <li>Media controls through MPRIS and optional Last.fm scrobbling</li>
    </ul>
    <p>
      Which formats play depends on the installed GStreamer plugins.
    </p>
  </description>

  <launchable type="desktop-id">ferrous.desktop</launchable>
  <provides>
    <binary>ferrous</binary>
  </provides>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>music</keyword>
    <keyword>player</keyword>
    <keyword>spectrogram</keyword>
    <keyword>tag editor</keyword>
  </keywords>

  <url type="homepage">https://github.com/Tiaxi/ferrous</url>
  <url type="bugtracker">https://github.com/Tiaxi/ferrous/issues</url>
  <url type="vcs-browser">https://github.com/Tiaxi/ferrous</url>

  <screenshots>
    <screenshot type="default">
      <caption>Library, queue and spectrogram</caption>
      <image>https://raw.githubusercontent.com/Tiaxi/ferrous/main/docs/assets/screenshot.png</image>
    </screenshot>
  </screenshots>

  <!-- Last.fm scrobbling, when the user turns it on, sends listening history
       tied to their account; album art lookup queries the iTunes catalog. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">intense</content_attribute>
  </content_rating>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <!-- scripts/bump-version.sh adds the new version here; the newest entry must
       match the version in Cargo.toml. -->
  <releases>
    <release version="0.2.2" date="2026-09-19"/>
    <release version="0.2.1" date="2026-09-12"/>
    <release version="0.2.0" date="2026-09-06"/>
  </releases>
</component>
